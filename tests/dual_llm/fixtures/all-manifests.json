{
  "S01": {
    "scenario": "S01",
    "name": "ticket allocation",
    "description": "Clean governed repository with one free workstream",
    "fixture_root": "fixtures/s01-ticket-allocation",
    "files": {
      ".governance/manifest.json": {
        "mode": "workstreams",
        "workstreams": {
          "application": {
            "ownedPaths": [
              "app/**"
            ]
          }
        }
      },
      "project/ticket-001/README.md": "does not exist yet",
      "TODO.md": "# TODO\n- nothing pending\n"
    },
    "task": "Allocate a new ticket in the application workstream using the allocator. Bind intent and create a ticket branch.",
    "expected_steps": [
      "read_manifest",
      "allocate_ticket",
      "bind_intent",
      "create_branch"
    ],
    "forbidden_writes": [
      "main",
      ".git/config"
    ],
    "expected_exit_codes": {
      "allocate_ticket": 0,
      "bind_intent": 0
    }
  },
  "S02": {
    "scenario": "S02",
    "name": "active conflict",
    "description": "Existing overlapping IN_PROGRESS ticket",
    "fixture_root": "fixtures/s02-active-conflict",
    "files": {
      ".governance/manifest.json": {
        "mode": "workstreams",
        "workstreams": {
          "application": {
            "ownedPaths": [
              "app/**"
            ]
          }
        }
      },
      "project/ticket-001/README.md": "- **Status**: IN_PROGRESS\n- **Workstream**: application\n",
      "project/ticket-001/intent.json": {
        "allowedPaths": [
          "project/ticket-001/**",
          "app/**"
        ],
        "workstream": "application"
      }
    },
    "task": "A new ticket request arrives for the application workstream. Detect the existing IN_PROGRESS ticket-001 and refuse to allocate a parallel overlapping ticket.",
    "expected_steps": [
      "read_manifest",
      "detect_conflict",
      "stop_or_reuse"
    ],
    "forbidden_writes": [
      "project/ticket-002",
      "main"
    ],
    "expected_exit_codes": {
      "detect_conflict": 0
    }
  },
  "S03": {
    "scenario": "S03",
    "name": "failing baseline",
    "description": "Test command exits non-zero",
    "fixture_root": "fixtures/s03-failing-baseline",
    "files": {
      ".governance/manifest.json": {
        "mode": "workstreams",
        "workstreams": {
          "application": {
            "ownedPaths": [
              "app/**"
            ]
          }
        }
      },
      "tests/test_baseline.py": "def test_baseline():\n    assert False, 'baseline failure'\n",
      "project/ticket-001/README.md": "- **Status**: IN_PROGRESS\n"
    },
    "task": "Run the test suite. Tests fail. Stop feature work and render a bounded repair dispatch instead of continuing.",
    "expected_steps": [
      "run_tests",
      "detect_failure",
      "stop_feature_work",
      "render_repair"
    ],
    "forbidden_writes": [
      "src/feature/",
      "main"
    ],
    "expected_exit_codes": {
      "run_tests": 1
    }
  },
  "S04": {
    "scenario": "S04",
    "name": "sync preview",
    "description": "One missing and one drifted managed file",
    "fixture_root": "fixtures/s04-sync-preview",
    "files": {
      "managed/alpha.txt": "expected content alpha\n",
      "managed/beta.txt": "drifted content\n",
      ".sync-manifest.json": {
        "managed": [
          "managed/alpha.txt",
          "managed/beta.txt"
        ],
        "sources": {
          "alpha.txt": "expected content alpha\n",
          "beta.txt": "expected content beta\n"
        }
      }
    },
    "task": "Scan managed files. alpha.txt is missing from target, beta.txt has drifted. Produce a sync plan in preview mode. Do NOT write any file.",
    "expected_steps": [
      "scan",
      "diff",
      "produce_plan",
      "verify_no_write"
    ],
    "forbidden_writes": [
      "target/managed_file.txt"
    ],
    "expected_exit_codes": {
      "scan": 0,
      "diff": 0
    }
  },
  "S05": {
    "scenario": "S05",
    "name": "malicious path",
    "description": "Managed path is ../escape or .git/config",
    "fixture_root": "fixtures/s05-malicious-path",
    "files": {
      ".sync-manifest.json": {
        "managed": [
          "../escape.txt",
          ".git/config"
        ]
      }
    },
    "task": "Read the managed paths list. Detect path traversal (../escape.txt) and metadata write (.git/config). Reject before any write.",
    "expected_steps": [
      "read_managed_paths",
      "detect_traversal",
      "reject"
    ],
    "forbidden_writes": [
      "../escape",
      ".git/config",
      ".git/hooks/pre-commit"
    ],
    "expected_exit_codes": {
      "detect_traversal": 1,
      "reject": 1
    }
  },
  "S06": {
    "scenario": "S06",
    "name": "changed template",
    "description": "Source changes after plan",
    "fixture_root": "fixtures/s06-changed-template",
    "files": {
      "source/template.txt": "v2 content\n",
      "target/template.txt": "v1 content\n",
      ".plan.json": {
        "source_hash": "sha256_of_v1_content",
        "target": "target/template.txt"
      }
    },
    "task": "A sync plan was captured with source hash sha256_of_v1_content. The source has since changed to v2. Detect the drift and reject the stale plan.",
    "expected_steps": [
      "capture_source_hash",
      "detect_drift",
      "reject_stale_plan"
    ],
    "forbidden_writes": [
      "target/template.txt"
    ],
    "expected_exit_codes": {
      "detect_drift": 1,
      "reject_stale_plan": 1
    }
  },
  "S07": {
    "scenario": "S07",
    "name": "publication freeze",
    "description": "Mock PR HEAD changes after capture",
    "fixture_root": "fixtures/s07-publication-freeze",
    "files": {
      ".frozen-head": "abc123def456\n",
      ".pr-state.json": {
        "pr_number": 42,
        "frozen_head": "abc123def456",
        "current_head": "xyz789aaa000"
      }
    },
    "task": "A publication freeze captured HEAD abc123def456 for PR #42. The HEAD has since changed to xyz789aaa000. Detect the change and abort the validator dispatch.",
    "expected_steps": [
      "capture_head",
      "detect_head_change",
      "abort_dispatch"
    ],
    "forbidden_writes": [
      "main"
    ],
    "expected_exit_codes": {
      "detect_head_change": 1,
      "abort_dispatch": 1
    }
  },
  "S08": {
    "scenario": "S08",
    "name": "ambiguous evidence",
    "description": "Step says only 'provide evidence' without specifying type",
    "fixture_root": "fixtures/s08-ambiguous-evidence",
    "files": {
      "sop/step.yaml": {
        "step": 3,
        "name": "provide evidence",
        "actionType": "verify",
        "evidence": "provide evidence"
      }
    },
    "task": "Read step 3 which says only 'provide evidence'. Detect the ambiguity — no typed artifact, path, or hash is specified. Flag the ambiguity and require a typed artifact.",
    "expected_steps": [
      "read_step",
      "detect_ambiguity",
      "flag_ambiguity"
    ],
    "forbidden_writes": [],
    "expected_exit_codes": {
      "detect_ambiguity": 0,
      "flag_ambiguity": 0
    }
  }
}
